[Unit]
Description=DevCat Yandex Mail and Disk MCP (CatVPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/opt/yacli-devcat/current
Environment=YACLI_DEVCAT_MODE=1
Environment=YACLI_DEVCAT_ACCOUNT=devcat
# Optional comma-separated additional accounts. The default account above remains the fallback.
# Environment=YACLI_DEVCAT_ALLOWED_ACCOUNTS=devcat,second-account
Environment=YACLI_DEVCAT_CAPABILITIES=mail.read,mail.send,disk.read,disk.write
Environment=YACLI_DEVCAT_DISK_ROOTS=disk:/DevCat
Environment=YACLI_DEVCAT_DOWNLOAD_ROOTS=/var/lib/yacli-devcat/downloads
Environment=YACLI_DEVCAT_UPLOAD_ROOTS=/var/lib/yacli-devcat/uploads
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/yacli-devcat/downloads /var/lib/yacli-devcat/uploads
# Managed Secure MCP Tunnel mode. DevCat still refuses non-loopback listeners.
Environment=YACLI_DEVCAT_TRUST_SECURE_TUNNEL=1
# For direct bearer-protected loopback mode instead, omit the line above and use:
# Environment=YACLI_DEVCAT_MCP_TOKEN_VAULT_KEY=DEVCAT_YANDEX_MCP_BEARER
Environment=YACLI_DEVCAT_OAUTH_CLIENT_ID=7caac656017c4cac84c193cef1e02a34
Environment=YACLI_DEVCAT_OAUTH_MAIL_FULL=1
Environment=YACLI_DEVCAT_VAULT_HELPER=/usr/local/libexec/catvps-vault
Environment=YACLI_CONFIG_DIR=/var/lib/yacli-devcat/config
ExecStart=/opt/yacli-devcat/current/yacli mcp --transport http --listen 127.0.0.1:8797
Restart=on-failure
RestartSec=5
StateDirectory=yacli-devcat
RuntimeDirectory=yacli-devcat
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/yacli-devcat
NoNewPrivileges=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
